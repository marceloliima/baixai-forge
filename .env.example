# Baixaí Forge v1.0.0
BAIXAI_HOST=127.0.0.1
BAIXAI_PORT=8765
BAIXAI_MAX_CONCURRENT=2
BAIXAI_JOB_RETRIES=1
BAIXAI_RETENTION_HOURS=72
BAIXAI_SOCKET_TIMEOUT=30
BAIXAI_MIN_FREE_DISK_MB=512
BAIXAI_LOG_LEVEL=INFO

# Descomente se quiser impedir a abertura automática do navegador.
# BAIXAI_NO_BROWSER=1

# Conteúdo autenticado: use somente sua própria sessão e quando tiver autorização.
# BAIXAI_COOKIES_FILE=C:\caminho\cookies.txt
# BAIXAI_COOKIES_BROWSER=chrome

# Alteração avançada da pasta de downloads:
# BAIXAI_DOWNLOAD_DIR=D:\Downloads\BaixaiForge
